# herdr configuration — mirrors ~/.config/tmux/tmux.conf (keybindings only)

onboarding = false

[keys]
# Trigger = `
prefix = "backtick"

# bind f resize-pane -Z
zoom = "prefix+f"

# Already matching tmux by default, listed here so they're explicit:
#   bind - split-window -v / bind v split-window -h
split_horizontal = "prefix+minus"
split_vertical = "prefix+v"
#   bind h/j/k/l select-pane -L/-D/-U/-R
focus_pane_left = "prefix+h"
focus_pane_down = "prefix+j"
focus_pane_up = "prefix+k"
focus_pane_right = "prefix+l"

[ui]
# set -g mouse on
mouse_capture = true

[advanced]
# set -g history-limit 10000 (herdr caps by bytes, not lines)
scrollback_limit_bytes = 10000000
